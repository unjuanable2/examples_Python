########################## exp1 ##########################

# 目的：忽略 exp1 目录下的 __pycache__ 文件夹，避免将编译后的 Python 字节码文件提交到版本控制系统中。
exp1/__pycache__/

# 目的：忽略 exp1/models 目录下的 __pycache__ 文件夹，避免将编译后的 Python 字节码文件提交到版本控制系统中。
exp1/models/__pycache__/

# 目的：忽略 exp1/data 目录下的所有文件 (有点大)，除了 .gitkeep 文件。
# .gitkeep 文件的作用：一个空的占位文件，用于确保 Git 能够跟踪空目录。
#                   因为 Git 默认不跟踪空目录，所以在需要保留空目录结构时，可以放置一个 .gitkeep 文件。
exp1/data/*
!exp1/data/.gitkeep

# 目的：忽略 exp1/weights 目录下训练生成的模型权重，除了 .gitkeep 文件。
# .gitkeep 文件的作用：一个空的占位文件，用于确保 Git 能够跟踪空目录。
exp1/weights/*
!exp1/weights/.gitkeep

########################## exp4 ##########################

# COCO 2014 验证图片、YOLO 标签和机器相关的绝对路径列表体积大或不可跨机器复用。
# Git 只同步下载脚本和代码；每台 GPU 设备在本机执行 exp4/run_exp.sh download。
exp4/data/coco/

# 老师提供及剪枝生成的模型权重很大，不应直接提交到普通 GitHub 仓库。
exp4/weights/*.weights
exp4/weights/*.pt

# detect.py 每次运行生成的视频及其它实验结果默认不提交；保留文本日志，
# 便于记录原模型检测、50% 剪枝和剪枝模型检测的完整终端输出。
exp4/results_analysis/*
!exp4/results_analysis/*.log
exp4/results.json
